# Database (Railway Postgres)
DATABASE_URL=

# Auth (NextAuth) — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in (invite-only: email must already exist in `users`)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (company logo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM="Eigensu <contact@eigensu.in>"

# Canva (invoice PDFs are autofilled into this Brand Template — see
# apps/web/lib/canva/. Connect at /admin/settings after setting these.)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=

# Automation
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=
APP_TIMEZONE=Asia/Kolkata

# Seed
SEED_DEMO=false
# Optional: seed founder passwords directly instead of printing set-password links
SEED_FOUNDER_PASSWORD=
